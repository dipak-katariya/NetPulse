<Window x:Class="NetPulse.UI.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPulse"
        Icon="pack://application:,,,/Assets/NetPulse.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="RootBorder"
            CornerRadius="12"
            Padding="14,6,14,6"
            BorderThickness="1"
            BorderBrush="#22FFFFFF">
        <Border.Background>
            <SolidColorBrush x:Name="BackdropBrush" Color="#CC202020"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
        <Grid x:Name="SingleRowLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="DownArrowSingle"
                      Data="M 5,0 L 5,8 L 0,5 M 5,8 L 10,5"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"/>
                <TextBlock x:Name="DownValueSingle"
                           Text="0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="DownUnitSingle"
                           Text="KB/s"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="UpArrowSingle"
                      Data="M 5,8 L 5,0 L 0,3 M 5,0 L 10,3"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"/>
                <TextBlock x:Name="UpValueSingle"
                           Text="0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="UpUnitSingle"
                           Text="KB/s"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="TwoRowLayout" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Path x:Name="UpArrowTwo"
                      Data="M 5,8 L 5,0 L 0,3 M 5,0 L 10,3"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"/>
                <TextBlock x:Name="UpValueTwo"
                           Text="0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="UpUnitTwo"
                           Text="KB/s"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                <Path x:Name="DownArrowTwo"
                      Data="M 5,0 L 5,8 L 0,5 M 5,8 L 10,5"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"/>
                <TextBlock x:Name="DownValueTwo"
                           Text="0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="DownUnitTwo"
                           Text="KB/s"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetContextMenu"/>
    </Window.ContextMenu>
</Window>
