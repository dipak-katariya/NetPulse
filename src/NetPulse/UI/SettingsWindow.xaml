<Window x:Class="NetPulse.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetPulse Settings"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#202024"
        Foreground="#F2F2F7"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#F2F2F7"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="18">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick"/>
            <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="540">
            <StackPanel>

                <GroupBox Header="Display">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Layout"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LayoutCombo">
                            <ComboBoxItem Content="Single row (↓ down  ↑ up)" Tag="SingleRow"/>
                            <ComboBoxItem Content="Two rows (upload above, download below)" Tag="TwoRows"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed units"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="UnitsCombo">
                            <ComboBoxItem Content="Bytes (KB/s, MB/s — binary 1024)" Tag="Bytes"/>
                            <ComboBoxItem Content="Bits (Kbps, Mbps — decimal 1000)" Tag="Bits"/>
                        </ComboBox>

                        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="PinToTaskbarCheck"
                                  Content="Pin next to taskbar tray (auto-position)"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Appearance">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeCombo">
                            <ComboBoxItem Content="Follow Windows" Tag="System"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                        </ComboBox>

                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  x:Name="UseSystemFontCheck"
                                  Content="Use the Windows system font and size"
                                  Click="OnUseSystemFontClick"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Font family"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FontFamilyCombo" IsEditable="True"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Font size"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="FontSizeCombo" IsEditable="True">
                            <ComboBoxItem>11</ComboBoxItem>
                            <ComboBoxItem>12</ComboBoxItem>
                            <ComboBoxItem>13</ComboBoxItem>
                            <ComboBoxItem>14</ComboBoxItem>
                            <ComboBoxItem>16</ComboBoxItem>
                            <ComboBoxItem>18</ComboBoxItem>
                            <ComboBoxItem>20</ComboBoxItem>
                            <ComboBoxItem>24</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Font color"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="FontColorBox"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Startup">
                    <StackPanel>
                        <TextBlock Text="Choose how NetPulse runs when you sign in:"
                                   Margin="0,0,0,6"/>
                        <RadioButton x:Name="AutostartAlwaysRadio"
                                     GroupName="Autostart"
                                     Foreground="#F2F2F7"
                                     Margin="0,4"
                                     Content="Always start with Windows (auto-run on every boot)"/>
                        <RadioButton x:Name="AutostartOneTimeRadio"
                                     GroupName="Autostart"
                                     Foreground="#F2F2F7"
                                     Margin="0,4"
                                     Content="Just this session (one-time run — no auto-start)"/>
                        <RadioButton x:Name="AutostartDisabledRadio"
                                     GroupName="Autostart"
                                     Foreground="#F2F2F7"
                                     Margin="0,4"
                                     Content="Disabled (don't add to Windows startup)"/>
                        <CheckBox x:Name="StartHiddenCheck"
                                  Content="Start with widget hidden (only tray icon)"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="About">
                    <StackPanel>
                        <TextBlock x:Name="AboutVersionText" Text="NetPulse 0.1.0"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="100% offline. Reads only your local network adapter byte counters. No data leaves your machine."
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="AboutSignatureText"
                                   Text="Signature: not signed"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
