<Application x:Class="NetPulse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
            <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#8E8E93"/>
            <SolidColorBrush x:Key="AccentDown" Color="#34C759"/>
            <SolidColorBrush x:Key="AccentUp" Color="#FF9F0A"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
